<UserControl x:Class="WordleItaliano.Controls.FavoritesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WordleItaliano.Converters"
             Width="276" MaxHeight="520">
    <UserControl.Resources>
        <conv:BoolToThemeBrushConverter x:Key="ThemeBrush" />
        <conv:TileStateToBrushConverter x:Key="TileBrush" />
        <conv:TileStateToBorderBrushConverter x:Key="TileBorderBrush" />
        <conv:TileStateToForegroundConverter x:Key="TileForeground" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarDay}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarHover}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /><Setter TargetName="Chrome" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}" /><Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SaveWord" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" BorderThickness="1" CornerRadius="3"
                        Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                        BorderBrush="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                        <Setter TargetName="Chrome" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}" />
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarDay}" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Margin="2" CornerRadius="3" Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarDay}" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="PanelFrame" Padding="10" BorderThickness="1" CornerRadius="6" AllowDrop="True"
            PreviewDragOver="SubmittedWord_DragOver" PreviewDragLeave="SubmittedWord_DragLeave" PreviewDrop="SubmittedWord_Drop"
            TextElement.Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}"
            Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
            BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Preferiti" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Grid.Row="1">
                <Button Content="+ Aggiungi parola" Command="{Binding OpenFavoriteFormCommand}"
                        Style="{StaticResource SaveWord}" HorizontalAlignment="Left" />
                <StackPanel x:Name="ManualFavoriteForm" Margin="0,8,0,6"
                            IsVisibleChanged="ManualFavoriteForm_IsVisibleChanged"
                            Visibility="{Binding IsManualFavoriteOpen, Converter={StaticResource BoolVisibility}}">
                    <TextBox x:Name="ManualWordInput" Text="{Binding ManualFavoriteText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6" ToolTip="Parola da 5, 6 o 7 lettere"
                             Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                             Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}"
                             BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Aggiungi" Command="{Binding ConfirmManualFavoriteCommand}" Style="{StaticResource SaveWord}" Margin="0,0,6,0" />
                        <Button Content="Annulla" Command="{Binding CancelFavoriteFormCommand}" Style="{StaticResource Action}" />
                    </WrapPanel>
                </StackPanel>
                <TextBlock Text="{Binding ManualFavoriteMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding HasManualFavoriteMessage, Converter={StaticResource BoolVisibility}}"
                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                <Button Content="{Binding SaveFavoriteText}" IsEnabled="{Binding CanFavoriteCurrentWord}"
                        Command="{Binding AddCurrentFavoriteCommand}" Style="{StaticResource Action}" Margin="0,6,0,0"
                        ToolTip="{Binding SaveFavoriteTooltip}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" />
                <CheckBox IsChecked="{Binding HideFavoritesWithAbsentLetters}" Margin="0,8,0,8" Focusable="False"
                          ToolTip="Esclude parole con lettere sicuramente assenti secondo la tastiera. Non verifica tutti i vincoli della soluzione.">
                    <CheckBox.Template><ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Mark" Width="16" Height="16" Margin="0,1,6,0" VerticalAlignment="Top" BorderThickness="1"
                                    BorderBrush="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                    Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}">
                                <TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" HorizontalAlignment="Center"
                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
                            </Border>
                            <TextBlock Text="Escludi parole con lettere assenti" TextWrapping="Wrap" Width="210"
                                       Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible" /><Setter TargetName="Mark" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></CheckBox.Template>
                </CheckBox>
            </StackPanel>
            <StackPanel Grid.Row="2" Visibility="{Binding IsFavoritesEmpty, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,8">
                <TextBlock Text="{Binding FavoritesEmptyText}" TextWrapping="Wrap" FontSize="12" />
                <Button Content="Mostra tutte" Command="{Binding ShowAllFavoritesCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Visibility="{Binding CanShowAllFavorites, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Action}" />
            </StackPanel>
            <AdornerDecorator Grid.Row="3">
            <ScrollViewer x:Name="WordsScroll" MaxHeight="330" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,3"
                          AllowDrop="True" PreviewDragOver="Words_DragOver" PreviewDragLeave="Words_DragLeave" PreviewDrop="Words_Drop">
                <ItemsControl x:Name="WordsItems" ItemsSource="{Binding FavoriteWords}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border x:Name="FavoriteRow" Margin="0,2" BorderThickness="1" CornerRadius="3"
                                BorderBrush="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                <Border Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarDay}"
                                        ToolTip="Trascina per riordinare" Cursor="SizeAll" PreviewMouseLeftButtonDown="Handle_MouseDown" PreviewMouseMove="Handle_MouseMove" PreviewMouseLeftButtonUp="Handle_MouseUp">
                                    <TextBlock Text="⋮⋮" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                </Border>
                                <Button Grid.Column="1" Padding="3,7" Style="{StaticResource Action}" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.InsertFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Word}"
                                        IsEnabled="{Binding DataContext.CanUseFavoriteWord, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="I colori indicano gli indizi noti delle lettere, non la loro posizione. L'inserimento è disponibile solo durante la partita.">
                                    <ItemsControl ItemsSource="{Binding Letters}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Width="23" Height="27" Margin="1" BorderThickness="1">
                                                <Border.Background><MultiBinding Converter="{StaticResource TileBrush}"><Binding Path="State" /><Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Border.Background>
                                                <Border.BorderBrush><MultiBinding Converter="{StaticResource TileBorderBrush}"><Binding Path="State" /><Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Border.BorderBrush>
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                                    <TextBlock.Foreground><MultiBinding Converter="{StaticResource TileForeground}"><Binding Path="State" /><Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Button>
                                <Button Grid.Column="2" Content="×" ToolTip="Rimuovi dai preferiti" Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Word}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Visibility" Value="Hidden" /><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=FavoriteRow}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="FavoriteRow" Property="IsMouseOver" Value="True"><Setter TargetName="FavoriteRow" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarHover}" /></Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </AdornerDecorator>
            <Border x:Name="SubmittedDropTarget" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                    BorderThickness="2" CornerRadius="4" Opacity="0.65">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="+" FontSize="28" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SubmittedDropWord" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
