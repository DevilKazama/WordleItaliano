            </Border>
        </Grid>

        <Grid x:Name="PerfectShotCelebrationOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="26"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              IsVisibleChanged="PerfectShotCelebrationOverlay_IsVisibleChanged"
              Visibility="{Binding IsPerfectShotCelebrationVisible, Converter={StaticResource BoolVisibility}}">
            <Canvas x:Name="PerfectShotParticleCanvas"
                    IsHitTestVisible="False" />
            <Border x:Name="PerfectShotCelebrationCard"
                    Width="500"
                    Padding="28"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=PerfectShot}"
                    BorderThickness="2"
                    CornerRadius="8">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="PerfectShotGlow"
                                      Color="{Binding ThemeMode, Converter={StaticResource ThemeColor}, ConverterParameter=PerfectShot}"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="PerfectShotCelebrationTitle"
                               Text="COLPO PERFETTO!"
                               FontSize="34"
                               FontWeight="Black"
                               TextAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=PerfectShot}">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Hai indovinato la parola al primo tentativo!"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Panel.ZIndex="27"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Visibility="{Binding IsPerfectShotPrizeDialogVisible, Converter={StaticResource BoolVisibility}}">
