                                                       FontSize="13"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsDictionaryStatusVisible, Converter={StaticResource BoolVisibility}}"
                                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
