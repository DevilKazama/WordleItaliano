                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tema"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                <TextBlock Text="Scegli lo stile del gioco."
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="IBP scuro"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="{x:Static theme:ThemeModes.IbpDark}"
                                        Tag="{Binding IsIbpDarkThemeActive}"
                                        Style="{StaticResource HistoryFilterButtonStyle}" />
                                <Button Content="IBP chiaro"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="{x:Static theme:ThemeModes.IbpLight}"
                                        Tag="{Binding IsIbpLightThemeActive}"
                                        Style="{StaticResource HistoryFilterButtonStyle}" />
                                <Button Content="Originale"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="{x:Static theme:ThemeModes.Original}"
