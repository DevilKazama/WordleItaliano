                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource TileBrush}">
                                    <Binding Source="{x:Static models:TileState.Absent}" />
                                    <Binding Path="ThemeMode" />
                                </MultiBinding>
                            </Border.Background>
                        </Border>
