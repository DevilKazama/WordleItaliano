                    </StackPanel>
                </StackPanel>
            </Grid>
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="FavoritesTab" Grid.Row="0" Grid.RowSpan="3" Width="28" Height="48" Padding="0" FontSize="14"
                VerticalAlignment="Center" HorizontalAlignment="{Binding FavoritesTabAlignment}"
                Content="{Binding FavoritesTabArrow}" Focusable="False"
                Style="{StaticResource FavoriteButtonStyle}"
                Visibility="{Binding IsFavoritesAvailable, Converter={StaticResource BoolVisibility}}"
                ToolTip="{Binding FavoritesToggleTooltip}" Command="{Binding ToggleFavoritesPanelCommand}" />

            <StackPanel x:Name="GameKeyboard" Grid.Row="2"
