                                                CornerRadius="5"
                                                Opacity="0.9" />
                                        <Border Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                                CornerRadius="5" />
