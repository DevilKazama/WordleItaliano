                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Distribuzione vittorie"
                               FontSize="16"
