                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Aggiornamenti"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    <TextBlock Text="{Binding AppVersionText}"
                                               Margin="0,4,0,0"
                                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button Content="Novità"
                                            Command="{Binding ShowChangelogCommand}"
                                            Style="{StaticResource TopButtonStyle}" />
                                    <Button Content="Controlla"
                                            Command="{Binding CheckUpdatesCommand}"
                                            Margin="8,4,4,4"
                                            Style="{StaticResource TopButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsUpdateStatusVisible, Converter={StaticResource BoolVisibility}}"
                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Visibility="{Binding IsUpdateDialogVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="520"
                    MaxWidth="620"
                    MaxHeight="620"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding UpdateDialogTitle}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding DismissUpdateCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <TextBlock Text="{Binding AvailableVersionText}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <TextBlock Text="{Binding UpdateDialogMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <Border Padding="12"
                            Margin="0,0,0,14"
                            CornerRadius="6"
                            BorderThickness="1"
                            Visibility="{Binding IsUpdateReleaseNotesVisible, Converter={StaticResource BoolVisibility}}"
                            Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                            BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
                        <StackPanel>
                            <TextBlock Text="Novità"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"
                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                            <ScrollViewer MaxHeight="260"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding UpdateReleaseNotesText}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding UpdateProgressText}"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolVisibility}}"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <ProgressBar Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding UpdateProgressValue}"
                                 Margin="0,0,0,14"
                                 Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolVisibility}}"
                                  Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                 Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                 BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Più tardi"
                                Command="{Binding DismissUpdateCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                        <Button Content="Aggiorna ora"
                                Command="{Binding InstallUpdateCommand}"
                                Margin="8,4,4,4"
                                Padding="14,8"
                                FontWeight="Bold"
                                Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}"
                                Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Focusable="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Visibility="{Binding IsChangelogVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="520"
                    MaxWidth="620"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding ChangelogTitle}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding DismissChangelogCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <Border Padding="14"
                            Margin="0,0,0,18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                            Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}">
                        <ScrollViewer MaxHeight="420"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ChangelogText}"
                                       FontSize="14"
                                       LineHeight="24"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        </ScrollViewer>
                    </Border>

                    <Button Content="Ok"
                            Command="{Binding DismissChangelogCommand}"
                            Height="42"
                            HorizontalAlignment="Right"
                            MinWidth="96"
                            FontWeight="Bold"
                            Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                            Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}"
                            BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Focusable="False" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Panel.ZIndex="45"
              Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="500"
                    MaxWidth="560"
                    MaxHeight="620"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Storico"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Tutte"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Tutte"
                                    Tag="{Binding IsHistoryFilterAllActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Giornaliere"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Giornaliere"
                                    Tag="{Binding IsHistoryFilterDailyActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Bonus"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Bonus"
                                    Tag="{Binding IsHistoryFilterBonusActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Infinite"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Infinite"
                                    Tag="{Binding IsHistoryFilterInfiniteActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Vinte"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Vinte"
                                    Tag="{Binding IsHistoryFilterWonActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Perse"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Perse"
                                    Tag="{Binding IsHistoryFilterLostActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,10"
                                   Visibility="{Binding IsHistoryFilterBonusActive, Converter={StaticResource BoolVisibility}}">
                            <Button Content="Tutte"
                                    Command="{Binding SetHistoryBonusLengthCommand}" CommandParameter="0"
                                    Tag="{Binding IsHistoryBonusLengthAllActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="5 lettere"
                                    Command="{Binding SetHistoryBonusLengthCommand}" CommandParameter="5"
                                    Tag="{Binding IsHistoryBonusLengthFiveActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="6 lettere"
                                    Command="{Binding SetHistoryBonusLengthCommand}" CommandParameter="6"
                                    Tag="{Binding IsHistoryBonusLengthSixActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="7 lettere"
                                    Command="{Binding SetHistoryBonusLengthCommand}" CommandParameter="7"
                                    Tag="{Binding IsHistoryBonusLengthSevenActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                        </WrapPanel>
                        <CheckBox Content="Solo preferiti" IsChecked="{Binding HistoryOnlyFavorites}" Margin="4,0,0,10" Style="{StaticResource FavoriteCheckStyle}"
                                  Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <TextBlock Text="{Binding HistoryFilterLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,10"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                        <StackPanel Margin="0,0,0,14"
                                    Visibility="{Binding IsInfiniteHistoryStatsVisible, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding InfiniteStatCards}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}"
                                                           TextAlignment="Center"
                                                           FontSize="22"
                                                           FontWeight="Black"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                <TextBlock Text="{Binding Label}"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <Border Margin="0,0,22,12"
                                Padding="14"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                Visibility="{Binding IsHistoryEmptyVisible, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding HistoryEmptyMessage}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                        <Border Padding="0,0,22,0">
                            <ItemsControl ItemsSource="{Binding HistoryRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="16"
                                                BorderThickness="1"
                                                BorderBrush="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                                Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="116" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="{Binding Date}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                    <TextBlock Text="{Binding Mode}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0"
                                                               Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding Points}"
                                                               TextAlignment="Right"
                                                               FontWeight="Bold"
                                                               Visibility="{Binding IsPointsVisible, Converter={StaticResource BoolVisibility}}"
                                                               Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                    <Button Content="Copia"
                                                            Command="{Binding DataContext.CopyHistoryResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding ShareText}"
                                                            Margin="0,8,0,0"
                                                            Style="{StaticResource PrimaryCompactButtonStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Margin="0,14,0,0">
                                                    <TextBlock Text="{Binding Solution}"
                                                               FontSize="22"
                                                               FontWeight="Black"
                                                               Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
                                                    <Button Content="{Binding FavoriteIcon}" ToolTip="{Binding FavoriteTooltip}"
                                                            Tag="{Binding IsFavorite}"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Solution}" Margin="6,0,0,0"
                                                            Style="{StaticResource FavoriteStarStyle}" />
                                                    <Border Margin="12,3,0,3"
                                                            Padding="8,3"
                                                            CornerRadius="5"
                                                            Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}">
                                                        <TextBlock Text="{Binding ResultSummary}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ResultTone}"
                                                               Margin="10,5,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                    <TextBlock Text="{Binding TimeText}"
                                                               Margin="10,5,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Visibility="{Binding IsTimeVisible, Converter={StaticResource BoolVisibility}}"
                                                               Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,10,0,0"
                                                           Text="{Binding GuessesSummary}"
                                                           FontSize="12"
                                                           LineHeight="20"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Visibility="{Binding IsWrappedVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="560"
                    MaxWidth="640"
                    MaxHeight="680"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Wordle Wrapped"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Mese"
                                        Command="{Binding SetWrappedModeCommand}"
                                        CommandParameter="Mese"
                                        Tag="{Binding IsWrappedMonthlyActive}"
                                        Style="{StaticResource HistoryFilterButtonStyle}" />
                                <Button Content="Anno"
                                        Command="{Binding SetWrappedModeCommand}"
                                        CommandParameter="Anno"
                                        Tag="{Binding IsWrappedYearlyActive}"
                                        Style="{StaticResource HistoryFilterButtonStyle}" />
                                <Button Content="&lt;"
                                        Command="{Binding PreviousWrappedPeriodCommand}"
                                        Style="{StaticResource TopButtonStyle}" />
                                <Button Content="&gt;"
                                        Command="{Binding NextWrappedPeriodCommand}"
                                        Style="{StaticResource TopButtonStyle}" />
                                <Button Content="{Binding WrappedCopyCurrentPeriodText}"
                                        Command="{Binding CopyMonthlyRecapCommand}"
                                        Style="{StaticResource TopButtonStyle}" />
                            </WrapPanel>

                            <TextBlock Text="{Binding WrappedPeriodLabel}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="4,0,0,14"
                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                            <Border Padding="14"
                                    Margin="0,0,0,14"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Scegli un periodo"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding WrappedCustomSummaryText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentHover}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dal"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"
                                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
