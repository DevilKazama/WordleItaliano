                            <Border.Background>
                                <MultiBinding Converter="{StaticResource TileBrush}">
                                    <Binding Source="{x:Static models:TileState.Correct}" />
                                    <Binding Path="ThemeMode" />
                                </MultiBinding>
                            </Border.Background>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="Lettera giusta nella posizione giusta."
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
