                                                   Placement="Bottom"
                                                   PlacementTarget="{Binding ElementName=WrappedStartDatePickerRoot}"
                                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                                                        BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                                        BorderThickness="1"
                                                        Padding="8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Content="‹"
                                                                    Command="{Binding MoveWrappedCalendarMonthCommand}"
                                                                    CommandParameter="Start:-1"
                                                                    Style="{StaticResource WrappedCalendarNavButtonStyle}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding WrappedStartCalendarTitle}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                            <Button Grid.Column="2"
                                                                    Content="›"
                                                                    Command="{Binding MoveWrappedCalendarMonthCommand}"
                                                                    CommandParameter="Start:1"
                                                                    Style="{StaticResource WrappedCalendarNavButtonStyle}" />
                                                        </Grid>
                                                        <UniformGrid Columns="7" Margin="0,0,0,4">
                                                            <TextBlock Text="L" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="M" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="M" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="G" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="V" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="S" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="D" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                        </UniformGrid>
                                                        <ItemsControl ItemsSource="{Binding WrappedStartCalendarDays}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="7" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding DayText}"
                                                                            Tag="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            Command="{Binding DataContext.SelectWrappedCalendarDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource WrappedCalendarDayCellStyle}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <TextBlock Grid.Column="3"
                                                   Text="Al"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"
                                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                        <Grid x:Name="WrappedEndDatePickerRoot"
                                              Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding WrappedCustomEndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource WrappedDateTextBoxStyle}" />
                                            <Button Grid.Column="1"
                                                    Content="▼"
                                                    Command="{Binding ToggleWrappedCalendarCommand}"
                                                    CommandParameter="End"
                                                    Style="{StaticResource WrappedDateDropButtonStyle}" />
                                            <Popup IsOpen="{Binding IsWrappedEndCalendarOpen, Mode=TwoWay}"
                                                   Placement="Bottom"
                                                   PlacementTarget="{Binding ElementName=WrappedEndDatePickerRoot}"
                                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                                                        BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                                        BorderThickness="1"
                                                        Padding="8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Content="‹"
                                                                    Command="{Binding MoveWrappedCalendarMonthCommand}"
                                                                    CommandParameter="End:-1"
                                                                    Style="{StaticResource WrappedCalendarNavButtonStyle}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding WrappedEndCalendarTitle}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                            <Button Grid.Column="2"
                                                                    Content="›"
                                                                    Command="{Binding MoveWrappedCalendarMonthCommand}"
                                                                    CommandParameter="End:1"
                                                                    Style="{StaticResource WrappedCalendarNavButtonStyle}" />
                                                        </Grid>
                                                        <UniformGrid Columns="7" Margin="0,0,0,4">
                                                            <TextBlock Text="L" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="M" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="M" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="G" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="V" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="S" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                            <TextBlock Text="D" TextAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                                        </UniformGrid>
                                                        <ItemsControl ItemsSource="{Binding WrappedEndCalendarDays}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="7" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding DayText}"
                                                                            Tag="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            Command="{Binding DataContext.SelectWrappedCalendarDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource WrappedCalendarDayCellStyle}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding WrappedCustomStatusText}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                        <Button Grid.Column="1"
                                                Content="{Binding WrappedCustomCopyButtonText}"
                                                Command="{Binding CopyWrappedCustomPeriodCommand}"
                                                MinWidth="128"
                                                Style="{StaticResource TopButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Padding="12"
                                    Margin="0,0,0,14"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Visibility="{Binding IsWrappedYearlyActive, Converter={StaticResource BoolVisibility}}"
                                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
                                <TextBlock Text="{Binding WrappedMonthlyScoresText}"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding WrappedStatCards}" Margin="0,0,0,18">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}"
                                                           TextAlignment="Center"
                                                           FontSize="22"
                                                           FontWeight="Black"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                <TextBlock Text="{Binding Label}"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Distribuzione risultati"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                            <ItemsControl ItemsSource="{Binding WrappedWinRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Attempt}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            <Grid Grid.Column="1" Height="30">
                                                <Border Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                                        BorderBrush="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="5" />
                                                <Border Width="{Binding BarWidth}"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                                        CornerRadius="5" />
                                                <TextBlock Text="{Binding Wins}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1"
                                    Margin="0,20,0,16"
                                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />

                            <TextBlock Text="Tempi"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                            <ItemsControl ItemsSource="{Binding WrappedTimeCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}"
                                                           TextAlignment="Center"
                                                           FontSize="20"
                                                           FontWeight="Black"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                <TextBlock Text="{Binding Label}"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Visibility="{Binding IsMonthlyRecapVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="520"
                    MaxWidth="580"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding MonthlyRecapTitle}"
                               FontSize="24"
                               FontWeight="Black"
                               Margin="0,0,0,18"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <ItemsControl ItemsSource="{Binding MonthlyRecapCards}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="Black"
                                                   Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                        <TextBlock Text="{Binding Label}"
                                                   TextAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Chiudi"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                        <Button Content="Copia mese"
                                Command="{Binding CopyMonthlyRecapCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                        <Button Content="Apri Wrapped completo"
                                Command="{Binding OpenMonthlyRecapWrappedCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Visibility="{Binding IsResetConfirmVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="460"
                    MaxWidth="540"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Cancella dati di gioco"
                               FontSize="24"
                               FontWeight="Black"
                               Margin="0,0,0,16"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <TextBlock Text="Questa operazione cancellerà definitivamente storico, statistiche, streak e punteggi."
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <TextBlock Text="Le impostazioni dell'app resteranno invariate."
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Annulla"
                                Command="{Binding CancelResetCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                        <Button Content="Cancella dati"
                                Command="{Binding ConfirmResetCommand}"
                                Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}"
                                BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                                Style="{StaticResource TopButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
              Visibility="{Binding IsSplashVisible, Converter={StaticResource BoolVisibility}}">
            <Border MaxWidth="420"
                    Padding="34"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Border Width="130"
                            Height="50"
                            Padding="10,6"
                            Margin="0,0,0,22"
                            HorizontalAlignment="Center"
                            Background="White"
                            BorderBrush="#C9D3D6"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsOriginalThemeActive, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
                        <Image Source="/Assets/IBPLogo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Wordle del Magazzino"
                               FontSize="34"
                               FontWeight="Black"
                               TextAlignment="Center"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SplashSubtitle}"
                               FontSize="18"
                               TextAlignment="Center"
                               Margin="0,12,0,28"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}"
                               TextWrapping="Wrap" />
                    <Button Content="Gioca"
                            Command="{Binding HideSplashCommand}"
                            Height="46"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                            Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Overlay}"
              Visibility="{Binding IsProfileDialogVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="420"
                    MaxWidth="520"
                    Padding="28"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Come ti chiami?"
                               FontSize="24"
                               FontWeight="Black"
                               Margin="0,0,0,18"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <TextBox Text="{Binding ProfileNameDraft, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             FontSize="16"
                             Padding="10,7"
                             MaxLength="30"
                             BorderThickness="1"
                             Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                             Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}"
                             BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
                    <TextBlock Text="{Binding ProfileError}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Error}" />
                    <Button Content="Continua"
                            Command="{Binding SaveProfileCommand}"
                            Height="44"
                            Margin="0,18,0,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}"
                            Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </AdornerDecorator>
</Window>


