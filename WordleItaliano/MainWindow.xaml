                            <Button Content="Sinistra" Command="{Binding SetFavoritesSideCommand}" CommandParameter="Sinistra"
                                    Tag="{Binding IsFavoritesLeft}" Style="{StaticResource HistoryFilterButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Padding="14"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
