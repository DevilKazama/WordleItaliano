<Window x:Class="WordleItaliano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WordleItaliano.Converters"
        xmlns:vm="clr-namespace:WordleItaliano.ViewModels"
        Title="Wordle Italiano"
        MinWidth="760"
        MinHeight="680"
        Width="760"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppIcon.png"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:TileStateToBrushConverter x:Key="TileBrush" />
        <conv:TileStateToBorderBrushConverter x:Key="TileBorderBrush" />
        <conv:TileStateToForegroundConverter x:Key="TileForeground" />
        <conv:BoolToThemeBrushConverter x:Key="ThemeBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisibility" />

        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}" />
            <Setter Property="Foreground" Value="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="BorderBrush" Value="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
        </Style>

        <Style x:Key="HistoryFilterButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}" />
            <Setter Property="Foreground" Value="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="BorderBrush" Value="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#538D4E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#538D4E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyboardButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{Binding State, Converter={StaticResource TileBrush}}" />
            <Setter Property="Foreground" Value="{Binding State, Converter={StaticResource TileForeground}}" />
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
            <DockPanel Margin="14,10">
                <TextBlock DockPanel.Dock="Left"
                           Text="Wordle Italiano"
                           FontSize="22"
                           FontWeight="Black"
                           VerticalAlignment="Center"
                           Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TopButtonStyle}" Content="?" Command="{Binding ShowHelpCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Grafico" Command="{Binding ShowStatisticsCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Storico" Command="{Binding ShowHistoryCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Wrapped" Command="{Binding ShowWrappedCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Tastiera" Command="{Binding ToggleKeyboardCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Infinita" Command="{Binding StartInfiniteCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Opzioni" Command="{Binding ShowSettingsCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,14">
                <Border HorizontalAlignment="Center"
                        Padding="10,4"
                        Margin="0,0,0,8"
                        CornerRadius="6"
                        Background="#538D4E">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModeBadgeText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding ModeBadgeDetail}"
                                   FontSize="12"
                                   Margin="8,0,0,0"
                                   Foreground="White"
                                   Opacity="0.86" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Message}"
                           TextAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="{Binding DailyTimerText}"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsDailyTimerVisible, Converter={StaticResource BoolVisibility}}"
                           Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="{Binding ScoreLineText}"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsScoreLineVisible, Converter={StaticResource BoolVisibility}}"
                           Foreground="#538D4E" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Copia risultato"
                            Command="{Binding CopyCurrentResultCommand}"
                            Visibility="{Binding IsCurrentResultCopyVisible, Converter={StaticResource BoolVisibility}}"
                            Style="{StaticResource TopButtonStyle}" />
                    <Button Content="Vedi bonus"
                            Command="{Binding ViewBonusCommand}"
                            Visibility="{Binding IsBonusViewButtonVisible, Converter={StaticResource BoolVisibility}}"
                            Style="{StaticResource TopButtonStyle}" />
                    <Button Content="Vedi giornaliera"
                            Command="{Binding ViewDailyCommand}"
                            Visibility="{Binding IsDailyViewButtonVisible, Converter={StaticResource BoolVisibility}}"
                            Style="{StaticResource TopButtonStyle}" />
                    <Button Content="Nuova infinita"
                            Command="{Binding StartInfiniteCommand}"
                            Visibility="{Binding IsNewInfiniteButtonVisible, Converter={StaticResource BoolVisibility}}"
                            Style="{StaticResource TopButtonStyle}" />
                </WrapPanel>
            </StackPanel>

            <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="430">
                <ItemsControl x:Name="Board" ItemsSource="{Binding Tiles}" Width="{Binding BoardWidth}" Height="420">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="{Binding DataContext.BoardColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Size}"
                                    Height="{Binding Size}"
                                    Margin="4"
                                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="{Binding State, Converter={StaticResource TileBrush}}" />
                                        <Setter Property="BorderBrush" Value="{Binding State, Converter={StaticResource TileBorderBrush}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderThickness" Value="4" />
                                                <Setter Property="BorderBrush" Value="#4A90E2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Letter}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="32"
                                           FontWeight="Black"
                                           Foreground="{Binding State, Converter={StaticResource TileForeground}}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="10,0,10,16"
                    Visibility="{Binding IsVirtualKeyboardVisible, Converter={StaticResource BoolVisibility}}">
            <ItemsControl ItemsSource="{Binding KeyboardRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Command="{Binding DataContext.KeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Label}"
                                            Style="{StaticResource KeyboardButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button Content="INVIO"
                        MinWidth="86"
                        Command="{Binding KeyCommand}"
                        CommandParameter="INVIO"
                        Style="{StaticResource TopButtonStyle}" />
                <Button Content="CANC"
                        MinWidth="86"
                        Command="{Binding KeyCommand}"
                        CommandParameter="CANC"
                        Style="{StaticResource TopButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.RowSpan="3"
              Panel.ZIndex="20"
              IsHitTestVisible="False">
            <Border Width="260"
                    Padding="14,10"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,82,0,0"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding ToastMessage}"
                           TextAlignment="Center"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsStatisticsVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="520"
                    MaxWidth="580"
                    MaxHeight="680"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock
                                   Text="Statistiche"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding StatCards}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel>
                                         <TextBlock Text="{Binding Value}"
                                                    TextAlignment="Center"
                                                    FontSize="24"
                                                    FontWeight="Black"
                                                   Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                        <TextBlock Text="{Binding Label}"
                                                   TextAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Distribuzione vittorie"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,4,0,10"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <ItemsControl ItemsSource="{Binding WinRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Attempt}"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    <Grid Grid.Column="1" Height="30">
                                        <Border Background="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                                BorderBrush="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Opacity="0.9" />
                                        <Border Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Background="#538D4E"
                                                CornerRadius="5" />
                                        <TextBlock Text="{Binding Wins}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1"
                            Margin="0,20,0,16"
                            Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />

                    <TextBlock Text="Distribuzione infinita"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <ItemsControl ItemsSource="{Binding InfiniteWinRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Attempt}"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    <Grid Grid.Column="1" Height="30">
                                        <Border Background="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                                BorderBrush="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Opacity="0.9" />
                                        <Border Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Background="#538D4E"
                                                CornerRadius="5" />
                                        <TextBlock Text="{Binding Wins}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1"
                            Margin="0,20,0,16"
                            Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />

                    <Button Content="Reset dati di gioco"
                            HorizontalAlignment="Left"
                            Command="{Binding ShowResetConfirmCommand}"
                            Style="{StaticResource TopButtonStyle}" />

                </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsBonusPromptVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="380"
                    Padding="26"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Bonus random sbloccato"
                               FontSize="24"
                               FontWeight="Black"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <Button Content="Gioca"
                            Command="{Binding StartBonusCommand}"
                            Height="44"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#538D4E"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsHelpVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="540"
                    MaxWidth="620"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="Come si gioca"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <TextBlock Text="Indovina la parola italiana del giorno in 6 tentativi."
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" Background="#538D4E" />
                        <TextBlock Grid.Column="1"
                                   Text="Lettera giusta nella posizione giusta."
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" Background="#C9B458" />
                        <TextBlock Grid.Column="1"
                                   Text="Lettera presente, ma in un'altra posizione."
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" Background="#787C7E" />
                        <TextBlock Grid.Column="1"
                                   Text="Lettera assente dalla parola."
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    </Grid>

                    <Border Padding="14"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                            Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}">
                        <TextBlock Text="Se vinci la giornaliera, si sblocca il bonus random da 5, 6 o 7 lettere per provare il secondo punto. Il bonus non interrompe la streak giornaliera."
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="520"
                    MaxWidth="620"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="Opzioni"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <Border Padding="14"
                            Margin="0,0,0,14"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                            Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tema"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                <TextBlock Text="Cambia tema chiaro/scuro."
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Cambia"
                                    Command="{Binding ToggleThemeCommand}"
                                    Style="{StaticResource TopButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Padding="14"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                            Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Aggiornamenti"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    <TextBlock Text="{Binding AppVersionText}"
                                               Margin="0,4,0,0"
                                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Controlla"
                                        Command="{Binding CheckUpdatesCommand}"
                                        Style="{StaticResource TopButtonStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsUpdateStatusVisible, Converter={StaticResource BoolVisibility}}"
                                       Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsUpdateDialogVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="520"
                    MaxWidth="620"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding UpdateDialogTitle}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding DismissUpdateCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <TextBlock Text="{Binding AvailableVersionText}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <TextBlock Text="{Binding UpdateDialogMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <Border Padding="12"
                            Margin="0,0,0,16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                            Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}">
                        <TextBlock Text="{Binding UpdateReleaseNotes}"
                                   MaxHeight="120"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                    </Border>

                    <TextBlock Text="{Binding UpdateProgressText}"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolVisibility}}"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Piu' tardi"
                                Command="{Binding DismissUpdateCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                        <Button Content="Aggiorna ora"
                                Command="{Binding InstallUpdateCommand}"
                                Margin="8,4,4,4"
                                Padding="14,8"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#538D4E"
                                BorderBrush="#538D4E"
                                BorderThickness="1"
                                Cursor="Hand"
                                Focusable="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="500"
                    MaxWidth="560"
                    MaxHeight="620"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Storico"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Tutte"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Tutte"
                                    Tag="{Binding IsHistoryFilterAllActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Giornaliere"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Giornaliere"
                                    Tag="{Binding IsHistoryFilterDailyActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Bonus"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Bonus"
                                    Tag="{Binding IsHistoryFilterBonusActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Infinite"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Infinite"
                                    Tag="{Binding IsHistoryFilterInfiniteActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Vinte"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Vinte"
                                    Tag="{Binding IsHistoryFilterWonActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                            <Button Content="Perse"
                                    Command="{Binding SetHistoryFilterCommand}"
                                    CommandParameter="Perse"
                                    Tag="{Binding IsHistoryFilterLostActive}"
                                    Style="{StaticResource HistoryFilterButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding HistoryFilterLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,10"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                        <StackPanel Margin="0,0,0,14"
                                    Visibility="{Binding IsInfiniteHistoryStatsVisible, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding InfiniteStatCards}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}"
                                                           TextAlignment="Center"
                                                           FontSize="22"
                                                           FontWeight="Black"
                                                           Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                <TextBlock Text="{Binding Label}"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <Border Margin="0,0,22,12"
                                Padding="14"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                Visibility="{Binding IsHistoryEmptyVisible, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding HistoryEmptyMessage}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                        <Border Padding="0,0,22,0">
                            <ItemsControl ItemsSource="{Binding HistoryRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="16"
                                                BorderThickness="1"
                                                BorderBrush="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                                Background="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="116" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="{Binding Date}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                    <TextBlock Text="{Binding Mode}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0"
                                                               Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding Points}"
                                                               TextAlignment="Right"
                                                               FontWeight="Bold"
                                                               Visibility="{Binding IsPointsVisible, Converter={StaticResource BoolVisibility}}"
                                                               Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                    <Button Content="Copia"
                                                            Command="{Binding DataContext.CopyHistoryResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding ShareText}"
                                                            Margin="0,8,0,0"
                                                            Style="{StaticResource TopButtonStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Margin="0,14,0,0">
                                                    <TextBlock Text="{Binding Solution}"
                                                               FontSize="22"
                                                               FontWeight="Black"
                                                               Foreground="#538D4E" />
                                                    <Border Margin="12,3,0,3"
                                                            Padding="8,3"
                                                            CornerRadius="5"
                                                            Background="#538D4E">
                                                        <TextBlock Text="{Binding ResultSummary}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="White" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ResultTone}"
                                                               Margin="10,5,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                    <TextBlock Text="{Binding TimeText}"
                                                               Margin="10,5,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Visibility="{Binding IsTimeVisible, Converter={StaticResource BoolVisibility}}"
                                                               Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,10,0,0"
                                                           Text="{Binding GuessesSummary}"
                                                           FontSize="12"
                                                           LineHeight="20"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsWrappedVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="560"
                    MaxWidth="640"
                    MaxHeight="680"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Wordle Wrapped"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="X"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Mese"
                                        Command="{Binding SetWrappedModeCommand}"
                                        CommandParameter="Mese"
                                        Tag="{Binding IsWrappedMonthlyActive}"
                                        Style="{StaticResource HistoryFilterButtonStyle}" />
                                <Button Content="Anno"
                                        Command="{Binding SetWrappedModeCommand}"
                                        CommandParameter="Anno"
                                        Tag="{Binding IsWrappedYearlyActive}"
                                        Style="{StaticResource HistoryFilterButtonStyle}" />
                                <Button Content="&lt;"
                                        Command="{Binding PreviousWrappedPeriodCommand}"
                                        Style="{StaticResource TopButtonStyle}" />
                                <Button Content="&gt;"
                                        Command="{Binding NextWrappedPeriodCommand}"
                                        Style="{StaticResource TopButtonStyle}" />
                            </WrapPanel>

                            <TextBlock Text="{Binding WrappedPeriodLabel}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="4,0,0,14"
                                       Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                            <Border Padding="12"
                                    Margin="0,0,0,14"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Visibility="{Binding IsWrappedYearlyActive, Converter={StaticResource BoolVisibility}}"
                                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
                                <TextBlock Text="{Binding WrappedMonthlyScoresText}"
                                           FontSize="12"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding WrappedStatCards}" Margin="0,0,0,18">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}"
                                                           TextAlignment="Center"
                                                           FontSize="22"
                                                           FontWeight="Black"
                                                           Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                <TextBlock Text="{Binding Label}"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Distribuzione risultati"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                            <ItemsControl ItemsSource="{Binding WrappedWinRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Attempt}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            <Grid Grid.Column="1" Height="30">
                                                <Border Background="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}"
                                                        BorderBrush="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="5" />
                                                <Border Width="{Binding BarWidth}"
                                                        HorizontalAlignment="Left"
                                                        Background="#538D4E"
                                                        CornerRadius="5" />
                                                <TextBlock Text="{Binding Wins}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           FontWeight="Bold"
                                                           Foreground="White" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1"
                                    Margin="0,20,0,16"
                                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />

                            <TextBlock Text="Tempi"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"
                                       Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                            <ItemsControl ItemsSource="{Binding WrappedTimeCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}"
                                                           TextAlignment="Center"
                                                           FontSize="20"
                                                           FontWeight="Black"
                                                           Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                                <TextBlock Text="{Binding Label}"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsMonthlyRecapVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="520"
                    MaxWidth="580"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding MonthlyRecapTitle}"
                               FontSize="24"
                               FontWeight="Black"
                               Margin="0,0,0,18"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />

                    <ItemsControl ItemsSource="{Binding MonthlyRecapCards}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}"
                                                   TextAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="Black"
                                                   Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                        <TextBlock Text="{Binding Label}"
                                                   TextAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Chiudi"
                                Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                        <Button Content="Apri Wrapped completo"
                                Command="{Binding OpenMonthlyRecapWrappedCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{Binding IsResetConfirmVisible, Converter={StaticResource BoolVisibility}}">
            <Border Width="460"
                    MaxWidth="540"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Reset dati di gioco"
                               FontSize="24"
                               FontWeight="Black"
                               Margin="0,0,0,16"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <TextBlock Text="Questa operazione cancellera' definitivamente storico, statistiche, streak e punteggi."
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <TextBlock Text="Le impostazioni dell'app resteranno invariate."
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               Foreground="{Binding IsDarkTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Annulla"
                                Command="{Binding CancelResetCommand}"
                                Style="{StaticResource TopButtonStyle}" />
                        <Button Content="Resetta dati"
                                Command="{Binding ConfirmResetCommand}"
                                Background="#538D4E"
                                Foreground="White"
                                BorderBrush="#538D4E"
                                Style="{StaticResource TopButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Background="#F8F8F8"
              Visibility="{Binding IsSplashVisible, Converter={StaticResource BoolVisibility}}">
            <Border MaxWidth="420"
                    Padding="34"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Wordle del Magazzino"
                               FontSize="34"
                               FontWeight="Black"
                               TextAlignment="Center"
                               Foreground="#121213"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SplashSubtitle}"
                               FontSize="18"
                               TextAlignment="Center"
                               Margin="0,12,0,28"
                               Foreground="#3A3A3C"
                               TextWrapping="Wrap" />
                    <Button Content="Gioca"
                            Command="{Binding HideSplashCommand}"
                            Height="46"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#538D4E"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
