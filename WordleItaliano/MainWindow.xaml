                            <Border.Background>
                                <MultiBinding Converter="{StaticResource TileBrush}">
                                    <Binding Source="{x:Static models:TileState.Present}" />
                                    <Binding Path="ThemeMode" />
                                </MultiBinding>
                            </Border.Background>
                        </Border>
