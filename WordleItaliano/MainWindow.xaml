                                              Grid.Column="1"
                                              Margin="0,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding WrappedCustomStartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource WrappedDateTextBoxStyle}" />
                                            <Button Grid.Column="1"
                                                    Content="▼"
                                                    Command="{Binding ToggleWrappedCalendarCommand}"
                                                    CommandParameter="Start"
                                                    Style="{StaticResource WrappedDateDropButtonStyle}" />
