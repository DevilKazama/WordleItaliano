                                            <TextBlock Text="{Binding DictionaryDefinitionText}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            <TextBlock Text="{Binding DictionaryExampleText}"
                                                       FontSize="12"
                                                       FontStyle="Italic"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsDictionaryExampleVisible, Converter={StaticResource BoolVisibility}}"
                                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
