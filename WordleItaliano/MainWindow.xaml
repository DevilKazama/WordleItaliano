<Window x:Class="WordleItaliano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WordleItaliano.Converters"
        xmlns:models="clr-namespace:WordleItaliano.Models"
        xmlns:theme="clr-namespace:WordleItaliano.Theme"
        xmlns:vm="clr-namespace:WordleItaliano.ViewModels"
        xmlns:controls="clr-namespace:WordleItaliano.Controls"
        Title="Wordle Italiano"
        MinWidth="760"
        MinHeight="680"
        Width="760"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppIcon.png"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:TileStateToBrushConverter x:Key="TileBrush" />
        <conv:TileStateToBorderBrushConverter x:Key="TileBorderBrush" />
        <conv:TileStateToForegroundConverter x:Key="TileForeground" />
        <conv:BoolToThemeBrushConverter x:Key="ThemeBrush" />
        <conv:ThemeColorConverter x:Key="ThemeColor" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisibility" />

        <Style x:Key="FavoriteButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarHover}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FavoriteStarStyle" TargetType="Button" BasedOn="{StaticResource FavoriteButtonStyle}">
            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Padding="4" CornerRadius="3"
                        Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarDay}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarHover}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FavoriteCheckStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Mark" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" BorderThickness="1"
                            BorderBrush="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                            Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}">
                        <TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" HorizontalAlignment="Center"
                                   Foreground="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
                    </Border>
                    <ContentPresenter />
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible" /><Setter TargetName="Mark" Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FavoriteExpanderStyle" TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" HorizontalContentAlignment="Left">
                        <ToggleButton.Foreground><Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource ThemeBrush}" ConverterParameter="Foreground" /></ToggleButton.Foreground>
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Padding="8" Background="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}" BorderThickness="1" BorderBrush="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="›" Margin="0,0,8,0" /><ContentPresenter /></StackPanel>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}" />
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
        </Style>

        <Style x:Key="HistoryFilterButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}" />
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
                    <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrappedDateTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarDay}" />
            <Setter Property="Foreground" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="BorderBrush" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="SelectionBrush" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
        </Style>

        <Style x:Key="WrappedDateDropButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
            <Setter Property="Foreground" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
            <Setter Property="BorderBrush" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentHover}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentHover}" />
                    <Setter Property="BorderBrush" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrappedCalendarNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarNav}" />
            <Setter Property="Foreground" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="BorderBrush" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarHover}" />
                    <Setter Property="BorderBrush" Value="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrappedCalendarDayCellStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarDay}" />
            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarHover}" />
                    <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
                    <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=CalendarOutside}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
                    <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentHover}" />
                    <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyboardButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TileBrush}">
                        <Binding Path="State" />
                        <Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TileForeground}">
                        <Binding Path="State" />
                        <Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource TopButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentHover}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <AdornerDecorator>
    <Grid x:Name="MainLayout" Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="MainHeader" Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Border Width="90"
                            Height="34"
                            Padding="7,4"
                            Margin="0,0,14,0"
                            Background="White"
                            BorderBrush="#C9D3D6"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsOriginalThemeActive, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
                        <Image Source="/Assets/IBPLogo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Wordle Italiano"
                               FontSize="21"
                               FontWeight="Black"
                               VerticalAlignment="Center"
                               MinWidth="156"
                               Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                </StackPanel>
                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Style="{StaticResource TopButtonStyle}" Content="?" Command="{Binding ShowHelpCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Grafico" Command="{Binding ShowStatisticsCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Storico" Command="{Binding ShowHistoryCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Wrapped" Command="{Binding ShowWrappedCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Tastiera" Command="{Binding ToggleKeyboardCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Infinita" Command="{Binding StartInfiniteCommand}" />
                    <Button Style="{StaticResource TopButtonStyle}" Content="Opzioni" Command="{Binding ShowSettingsCommand}" />
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,12,18,6">

            <StackPanel x:Name="GameHeading" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Border HorizontalAlignment="Center"
                        Padding="10,2"
                        Margin="0,0,0,3"
                        CornerRadius="6"
                        Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModeBadgeText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}" />
                        <TextBlock Text="{Binding ModeBadgeDetail}"
                                   FontSize="12"
                                   Margin="8,0,0,0"
                                   Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentForeground}"
                                   Opacity="0.86" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Message}"
                           TextAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="{Binding DailyTimerText}"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,1,0,0"
                           Visibility="{Binding IsDailyTimerVisible, Converter={StaticResource BoolVisibility}}"
                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="{Binding StreakLineText}"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,1,0,0"
                           Visibility="{Binding IsStreakLineVisible, Converter={StaticResource BoolVisibility}}"
                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                <TextBlock Text="{Binding ScoreLineText}"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,1,0,0"
                           Visibility="{Binding IsScoreLineVisible, Converter={StaticResource BoolVisibility}}"
                           Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Accent}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Viewbox Grid.Row="0"
                         Stretch="Uniform"
                         MaxHeight="282"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,0,0,2">
                    <ItemsControl x:Name="Board" ItemsSource="{Binding Tiles}" Width="{Binding BoardWidth}" Height="{Binding BoardHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="6" Columns="{Binding DataContext.BoardColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Size}"
                                        Height="{Binding Size}"
                                        Margin="4"
                                        MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                                        MouseMove="Tile_MouseMove" MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource TileBrush}">
                                                        <Binding Path="State" />
                                                        <Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource TileBorderBrush}">
                                                        <Binding Path="State" />
                                                        <Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderThickness" Value="4" />
                                                    <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThemeBrush}, ConverterParameter=AccentHover}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Letter}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontWeight="Black">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource TileForeground}">
                                                <Binding Path="State" />
                                                <Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>

                <StackPanel Grid.Row="1"
                            Visibility="{Binding IsGameActionsPanelVisible, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Width="620"
                                MaxWidth="620"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,0">
                        <StackPanel Margin="0,0,0,0"
                                    Visibility="{Binding IsDictionaryPanelVisible, Converter={StaticResource BoolVisibility}}">
                            <Border Margin="0,0,0,0"
                                    Width="420"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    MaxHeight="155"
                                    Visibility="{Binding IsDictionaryCardVisible, Converter={StaticResource BoolVisibility}}"
                                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="Nascondi"
                                                Command="{Binding HideDefinitionCommand}"
                                                Style="{StaticResource TopButtonStyle}"
                                                Padding="8,5"
                                                Margin="8,0,0,0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}"
                                                Opacity="0.76" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DictionaryWordText}"
                                                       FontSize="15"
                                                       FontWeight="Black"
                                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Foreground}" />
                                            <TextBlock Text="{Binding DictionaryPartOfSpeechText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ScrollViewer Margin="0,8,0,0"
                                                  MaxHeight="95"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
