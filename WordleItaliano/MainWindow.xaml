                    Padding="14,10"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,82,0,0"
                    Background="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Panel}"
                    BorderBrush="{Binding ThemeMode, Converter={StaticResource ThemeBrush}, ConverterParameter=Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding ToastMessage}"
                           TextAlignment="Center"
